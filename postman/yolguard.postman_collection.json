{
  "info": {
    "name": "YolGuard MVP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base", "value": "http://127.0.0.1:8002"},
    {"key": "access", "value": ""},
    {"key": "incident_id", "value": "1"}
  ],
  "item": [
    {"name": "health",
     "request": {"method": "GET", "url": "{{base}}/health"}},
    {"name": "register",
     "request": {"method": "POST", "url": "{{base}}/api/v1/auth/register",
       "header": [{"key": "Content-Type", "value": "application/json"}],
       "body": {"mode": "raw",
         "raw": "{\"phone\": \"+998900000011\", \"password\": \"driver123\", \"full_name\": \"Driver A\"}"}}},
    {"name": "login-driver",
     "request": {"method": "POST", "url": "{{base}}/api/v1/auth/login",
       "header": [{"key": "Content-Type", "value": "application/json"}],
       "body": {"mode": "raw",
         "raw": "{\"phone\": \"+998900000011\", \"password\": \"driver123\"}"}}},
    {"name": "create-incident",
     "request": {"method": "POST", "url": "{{base}}/api/v1/incidents",
       "header": [{"key": "Content-Type", "value": "application/json"},
                  {"key": "Authorization", "value": "Bearer {{access}}"}],
       "body": {"mode": "raw", "raw": "{}"}}},
    {"name": "triage",
     "request": {"method": "POST", "url": "{{base}}/api/v1/incidents/{{incident_id}}/triage",
       "header": [{"key": "Content-Type", "value": "application/json"},
                  {"key": "Authorization", "value": "Bearer {{access}}"}],
       "body": {"mode": "raw",
         "raw": "{\"responsibility_accepted\": true, \"sober\": true, \"docs_valid\": true, \"damage_agreed\": true}"}}},
    {"name": "evidence-upload",
     "request": {"method": "POST", "url": "{{base}}/api/v1/incidents/{{incident_id}}/evidence-upload",
       "header": [{"key": "Authorization", "value": "Bearer {{access}}"}],
       "body": {"mode": "formdata",
         "formdata": [{"key": "kind", "value": "damage_close", "type": "text"},
                      {"key": "file", "type": "file", "src": "/path/to/photo.jpg"}]}}},
    {"name": "ai-history",
     "request": {"method": "GET", "url": "{{base}}/api/v1/incidents/{{incident_id}}/ai-history",
       "header": [{"key": "Authorization", "value": "Bearer {{access}}"}]}},
    {"name": "admin-stats",
     "request": {"method": "GET", "url": "{{base}}/api/v1/admin/stats",
       "header": [{"key": "Authorization", "value": "Bearer {{access}}"}]}},
    {"name": "admin-incident-detail",
     "request": {"method": "GET", "url": "{{base}}/api/v1/admin/incidents/{{incident_id}}",
       "header": [{"key": "Authorization", "value": "Bearer {{access}}"}]}},
    {"name": "voice-note-upload",
     "request": {"method": "POST", "url": "{{base}}/api/v1/incidents/{{incident_id}}/evidence-upload",
       "header": [{"key": "Authorization", "value": "Bearer {{access}}"}],
       "body": {"mode": "formdata",
         "formdata": [{"key": "kind", "value": "voice_note", "type": "text"},
                      {"key": "file", "type": "file", "src": "/path/to/note.mp3"}]}}},
    {"name": "claim-package-read",
     "request": {"method": "GET", "url": "{{base}}/api/v1/incidents/{{incident_id}}/claim-package",
       "header": [{"key": "Authorization", "value": "Bearer {{access}}"}]}},
    {"name": "insurer-incidents",
     "request": {"method": "GET", "url": "{{base}}/api/v1/insurer/incidents",
       "header": [{"key": "Authorization", "value": "Bearer {{access}}"}]}},
    {"name": "push-subscribe",
     "request": {"method": "POST", "url": "{{base}}/api/v1/push/subscribe",
       "header": [{"key": "Content-Type", "value": "application/json"},
                  {"key": "Authorization", "value": "Bearer {{access}}"}],
       "body": {"mode": "raw",
         "raw": "{\"endpoint\": \"https://example.com/push/1\", \"keys\": {\"p256dh\": \"...\", \"auth\": \"...\"}}"}}}
  ]
}
