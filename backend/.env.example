# Generate a strong key: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Backend refuses to start if SECRET_KEY is a placeholder or shorter than 32 chars.
SECRET_KEY=change-me-in-prod-min-32-chars
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
DATABASE_URL=sqlite:///./yolguard.db
GEMINI_API_KEY=
# Optional: override the Gemini model chain (default: gemini-flash-latest -> lite -> 3-flash-preview)
GEMINI_MODEL=
# MongoDB document store (AI history, processing events, CV metadata).
# Empty = disabled; SQL keeps working as the source of truth.
MONGODB_URI=
MONGODB_DB=yolguard
# Web Push (VAPID). Empty = push disabled, clients use polling fallback.
# Generate once (pywebpush 2.x) and paste both lines below:
# py -c "from py_vapid import Vapid; from cryptography.hazmat.primitives import serialization; import base64; v=Vapid(); v.generate_keys(); b64=lambda b: base64.urlsafe_b64encode(b).decode().rstrip('='); print('PUB '+b64(v.public_key.public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint))); print('PRIV '+b64(v.private_key.private_bytes(serialization.Encoding.DER, serialization.PrivateFormat.PKCS8, serialization.NoEncryption())))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Local dir for uploaded photos/video/audio (metadata in SQL + Mongo).
UPLOAD_DIR=uploads
MAX_UPLOADS_PER_INCIDENT=30
# Explicit CORS allow-list (comma-separated). Never use "*".
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
